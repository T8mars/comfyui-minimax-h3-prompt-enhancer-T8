# Development and release tooling never belongs in the Manager archive.
.github/
.gitattributes
.gitignore
.comfyignore
tests/
tools/
case_templates/source_batches/
*_smoke.py

# T8 case GIFs remain in the GitHub repository for legacy/full-clone users.
# Registry installs use the signed, catalog-pinned preview asset channel instead.
/web/js/assets/t8-case-previews/*.gif
/web/js/assets/.t8-case-previews-*/

# Full GitHub installs keep the standalone llama-server bootstrap and optional
# environment/network compatibility helpers.  Registry installs use the
# in-process llama-cpp-python runtime and audited provider transport instead.
install_local_qwen.py
local_qwen_standalone_runtime.py
environment_defaults.py
credential_connection_probe.py

# Local/private state and repository-only maintenance files.
/AGENTS.md
/SKILL.md
/roadmap.md
/design-qa.md
.env
.env.*
runtime/
runtime_config.json
.user/
credentials.json
*.gguf
*.gguf.part
*.part
__pycache__/
*.py[cod]
